# Caddy automatically requests and renews a real Let's Encrypt certificate
# for whatever domain the DOMAIN env var names (set it in .env - see
# docker-compose.yml's caddy service), and redirects plain HTTP to HTTPS
# with zero extra config - that's Caddy's whole reason for being here
# instead of nginx. app-server itself is no longer exposed to the host at
# all (see docker-compose.yml: its "3000:3000" mapping was removed once
# this was added) - Caddy is the only public entrypoint, reverse-proxying
# to app-server over the internal aura-net bridge network.
{$DOMAIN} {
	reverse_proxy app-server:3000
}

# Runtime
NODE_ENV=development
PORT=3000
# Public URL of this app — used to build consent confirmation links in emails and QR codes.
APP_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Additional AI gateway providers
#
# Each one is registered ONLY when its API key is present, so an unconfigured
# provider can never receive customer conversation context. Lower priority
# numbers are tried first (see aiGatewayBootstrap.ts):
#
#   gemini      10  primary
#   openai      20  native Responses API, tool-capable
#   groq        25  OpenAI-compatible, tool-capable
#   cerebras    30  OpenAI-compatible, tool-capable
#   mistral     35  OpenAI-compatible, tool-capable
#   openrouter  40  text-only compatibility fallback
#   goose       50  text-only emergency path
#
# Every tool-capable provider above receives the same agent persona AND the
# same tool schemas the primary does, so a customer gets the same behaviour
# whichever model actually answered. The two text-only providers at the
# bottom genuinely cannot run tools - they stay last, and a reply that needed
# a tool escalates to a human rather than pretending the action happened.
OPENAI_API_KEY=
OPENAI_GATEWAY_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_GATEWAY_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

CEREBRAS_API_KEY=
CEREBRAS_GATEWAY_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

MISTRAL_API_KEY=
MISTRAL_GATEWAY_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Text-only compatibility fallback. Deliberately ranked below the
# tool-capable providers until its tool-calling adapter is upgraded and
# tested against AURA's exact contract.
OPENROUTER_API_KEY=
OPENROUTER_GATEWAY_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# WhatsApp
WHATSAPP_SESSION_DIR=./data/whatsapp-session

# Media storage. 'local' (default) writes encrypted files to MEDIA_STORAGE_DIR
# on disk - fine for a single-machine deployment. 's3' writes to an
# S3-compatible bucket instead (e.g. Tigris on Fly.io via `fly storage
# create`, which sets BUCKET_NAME/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/
# AWS_ENDPOINT_URL_S3 automatically) - required once app-server and
# app-worker run as separate machines/containers that can't share one local
# disk. See src/media/mediaStorage.ts.
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=./data/media-storage
# MEDIA_STORAGE_S3_BUCKET=   # only used when MEDIA_STORAGE_BACKEND=s3 (falls back to BUCKET_NAME)
# MEDIA_STORAGE_S3_FORCE_PATH_STYLE=false

# Persistence
DATABASE_URL=postgres://whatchatai:whatchatai_dev@localhost:5432/whatchatai_dev

# Redis (BullMQ ingestion queue, rate limiting, DEK cache)
REDIS_URL=redis://127.0.0.1:6379

# Field-level encryption. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=

# Sentinel AI model. Falls back to GEMINI_MODEL if unset.
GEMINI_SENTINEL_MODEL=

# AI reply generation model. Falls back to GEMINI_MODEL if unset, then to gemini-3.5-flash.
GEMINI_REPLY_MODEL=

# Platform owner/developer allowlist. Comma-separated authenticated emails.
WHATCHATAI_DEVELOPER_EMAILS=

# Outbound email fallback. Workspace settings in Settings -> Email take precedence.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Email OAuth (Gmail + Outlook unified inbox)
# Create credentials at console.cloud.google.com (Gmail) and portal.azure.com (Outlook).
# Redirect URIs to register: <APP_URL>/api/email-oauth/callback/gmail
#                            <APP_URL>/api/email-oauth/callback/outlook
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v3 (invisible, score-based) on public signup - stops
# bot/scripted registrations once this app is reachable from the open
# internet. Create a v3 site at google.com/recaptcha/admin, register your
# real domain there. Optional: leave both blank and signup works exactly as
# before, no verification attempted (see src/services/recaptchaService.ts).
# SITE_KEY is public by design (embedded in the page); SECRET_KEY is not.
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Google Meet booking (AI tool call - schedule_google_meet) reuses the
# GMAIL_CLIENT_ID/SECRET above rather than a separate credential - Google
# OAuth apps aren't scope-bound at registration, so the same client
# requests calendar.events in its own consent flow. Just enable the
# Calendar API on that same Google Cloud project.
# Redirect URI to register: <APP_URL>/api/meeting-oauth/callback/google_meet

# Zoom booking (AI tool call - schedule_zoom_meeting). Zoom has no
# equivalent client-reuse trick - create a separate "General App"
# (User-managed OAuth) at marketplace.zoom.us.
# Redirect URI to register: <APP_URL>/api/meeting-oauth/callback/zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Goose failover
#
# Gemini remains the primary model. Goose is attempted only after a genuine
# Gemini failure. The WhatchatAI client talks to a small HTTP adapter exposing
# GET /health and POST /generate. It is NOT a Goose installation URL.
#
# The application now starts the local Goose supervisor automatically as part
# of both `npm run dev` and `npm start`. The supervisor detects Goose, installs
# the official CLI on supported Unix-like development hosts when missing,
# starts Goose privately on GOOSE_UPSTREAM_PORT, and exposes the localhost-only
# WhatchatAI adapter on GOOSE_SERVICE_PORT. It monitors health, restarts Goose
# after unexpected exits/failures, and shuts it down cleanly with the app.
#
# Set GOOSE_AUTO_START=false to disable automatic startup.
# Set GOOSE_AUTO_INSTALL=false to require a manual Goose installation.
GOOSE_AUTO_START=true
GOOSE_AUTO_INSTALL=true
GOOSE_SERVICE_URL=http://127.0.0.1:3284
GOOSE_SERVICE_API_KEY=
# Required by the `goose serve` binary itself, not this codebase - leave
# empty to have gooseFallbackSupervisor.ts generate an ephemeral one at
# startup (fine for local/single-host use, since Goose is already
# loopback-only). Set a real value here only if you need it stable across
# restarts.
GOOSE_SERVER__SECRET_KEY=
GOOSE_SERVICE_HOST=127.0.0.1
GOOSE_SERVICE_PORT=3284
GOOSE_UPSTREAM_PORT=3285
GOOSE_HEALTH_INTERVAL_MS=10000
GOOSE_RESTART_BACKOFF_MS=2000
GOOSE_MAX_RESTARTS=10
GOOSE_BIN=
# Which underlying AI provider Goose itself calls to actually generate a
# fallback reply - deliberately NOT this app's own primary (Gemini), so a
# Gemini-specific outage never takes down its own failover too. Set to
# whichever provider you configure Goose with (openrouter recommended -
# one key, genuinely independent, can route to Claude/GPT/etc.) plus that
# provider's own API key env var (e.g. OPENROUTER_API_KEY, further down
# this file). In production (docker-compose.yml's goose service), this is
# overridden explicitly there rather than read from this file's own
# GOOSE_SERVICE_URL/HOST values, which only ever applied to a same-host
# dev setup.
GOOSE_PROVIDER=

# Goose can also be configured per workspace in Settings -> Goose failover.
# Workspace values take precedence over these environment defaults.

# ---------------------------------------------------------------------------
# Push-based incident alerting (src/services/alerting/). Watches the same
# health signals the developer dashboard shows (database, redis, queues,
# Goose) and pushes on a state change - never silently pull-only. Both
# channels are optional and independent; each no-ops with a logged reason
# when its own variables aren't set. Leave both empty in local development.
ALERT_MONITORING_ENABLED=true
ALERT_CHECK_INTERVAL_MS=300000
ALERT_REMINDER_INTERVAL_MS=21600000

# Email channel - reuses RESEND_API_KEY above.
ALERT_EMAIL_TO=
ALERT_FROM_EMAIL=

# Telegram channel - create a bot via @BotFather, then message it once and
# read the chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Section 117-122 follow-up: real vars that were in use but missing from
# this reference file (some already documented elsewhere, e.g.
# docs/PHASE_PRODUCT_ACCOUNT_BILLING_BIMPAY.md - centralized here too so
# this file stays the single place to check).

# BiMPay payment-provider webhook bridge - HMAC verification for
# POST /api/billing/providers/bimpay/bridge and /webhooks/:provider.
# billingRoutes.ts fails closed (503) when this is unset - never leave it
# empty in a real deployment that accepts BiMPay webhooks.
BIMPAY_BRIDGE_SECRET=

# PayPal payment provider (Section 73-74) - second real provider after
# BiMPay. Requires all three to be treated as configured (see
# billingRoutes.ts's isProviderConfigured); even once configured, it stays
# invisible to a real checkout until also enabled from the Developer
# Control Plane's Payment Providers panel (platform_settings, live, no
# redeploy needed). PAYPAL_ENV=live opts into the real PayPal API host -
# leave unset/'sandbox' everywhere except a genuine production deployment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=

# OpenClaw multi-agent runtime (optional) - only used when
# WHATCHATAI_AGENT_RUNTIME=openclaw is also set. Leave all three empty to
# keep agents on the default runtime.
WHATCHATAI_AGENT_RUNTIME=
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# src/relay/index.ts's own listen port. Defaults to 8080 when unset.
RELAY_PORT=8080

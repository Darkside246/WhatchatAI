# Runtime
NODE_ENV=development
PORT=3000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp
# The QR/Baileys authentication flow will be implemented in a dedicated service.
WHATSAPP_SESSION_DIR=./data/whatsapp-session

# Persistence
DATABASE_URL=postgres://whatchatai:whatchatai_dev@localhost:5432/whatchatai_dev

# Redis (BullMQ ingestion queue, rate limiting, DEK cache)
#
# The URL may carry a database index (redis://host:port/2). BullMQ queues
# live in the Redis keyspace, so anything sharing an index shares the queues:
# a dev server on the same index as the test suite will consume the suite's
# jobs, which shows up as tests failing for no reason and passing on a
# re-run. Tests default to index 1 and refuse index 0 outright
# (see vitest.config.ts and test/globalSetup.ts); dev uses index 0 below.
REDIS_URL=redis://127.0.0.1:6379

# Field-level encryption. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This is a LOCAL master key, not a cloud KMS - see src/security/encryption/kmsKeyProvider.ts.
MASTER_ENCRYPTION_KEY=

# Sentinel AI model (Stage 2 of the message security gate). Falls back to GEMINI_MODEL if unset.
GEMINI_SENTINEL_MODEL=

# AI reply generation model. Falls back to GEMINI_MODEL if unset, then to gemini-3.5-flash.
GEMINI_REPLY_MODEL=

# Platform owner/developer allowlist. Comma-separated authenticated emails.
# This is server-side configuration and is never accepted from a client request.
WHATCHATAI_DEVELOPER_EMAILS=

# ---------------------------------------------------------------------------
# Outbound email (Phase F5). Without this, drafts can still be written but
# CANNOT be approved - the app refuses up front rather than queueing a send
# that would only fail later.
#
# Resend is the implemented provider (src/services/emailProviderService.ts);
# swapping to Postmark or SES is that one file. You must also verify your
# sending domain with the provider and set a sender address in
# Settings -> Email, or sending is rejected by the provider, not by us.
# NOTE: this is now only a FALLBACK. Email is configured per workspace in
# Settings -> Email (SMTP server or Resend API key), and those settings win
# over this value. The UI reports which of the two is actually in effect.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Goose failover
#
# Gemini remains the primary model. Goose is only attempted after a genuine
# Gemini failure. WhatchatAI talks to Goose's authenticated HTTP /ask route.
#
# For local development, use:
#   npm run goose:fallback
#
# That launcher generates GOOSE_SERVICE_API_KEY if needed, stores it only in
# the gitignored .env, exports Goose's GOOSE_SERVER__SECRET_KEY, binds Goose
# to localhost, and forces GOOSE_MODE=chat. Chat mode disables Goose tools,
# which is important because customer WhatsApp messages are untrusted input.
GOOSE_SERVICE_URL=http://127.0.0.1:3284
GOOSE_SERVICE_API_KEY=
GOOSE_SERVICE_HOST=127.0.0.1
GOOSE_SERVICE_PORT=3284

# Goose can also be configured per workspace in Settings -> Goose failover.
# Workspace values take precedence over these environment defaults.

{
  "name": "whatchatai",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Production-first AI WhatsApp agent SaaS platform",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "DATABASE_URL=postgres://whatchatai:whatchatai_dev@localhost:5432/whatchatai_test vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@whiskeysockets/baileys": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "^8.23.0",
    "pino": "latest",
    "qrcode": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}

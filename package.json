{
  "name": "whatchatai",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Production-first AI WhatsApp agent SaaS platform",
  "type": "module",
  "workspaces": [
    "src/web"
  ],
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "concurrently -n backend,worker,frontend,goose -c blue,magenta,green,yellow \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:web\" \"npm:dev:goose\"",
    "dev:server": "tsx src/server/index.ts",
    "dev:worker": "tsx src/queue/workers/incomingMessagesWorker.ts",
    "dev:web": "npm run dev --workspace=src/web",
    "dev:goose": "tsx src/services/gooseFallbackSupervisor.ts",
    "goose:fallback": "tsx src/services/gooseFallbackSupervisor.ts",
    "build": "tsc && npm run build --workspace=src/web",
    "start": "concurrently -n backend,worker,goose -c blue,magenta,yellow \"npm:start:server\" \"npm:start:worker\" \"npm:start:goose\"",
    "start:server": "node dist/server/index.js",
    "start:worker": "node dist/queue/workers/incomingMessagesWorker.js",
    "start:goose": "node dist/services/gooseFallbackSupervisor.js",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=src/web",
    "check:ai-call-sites": "tsx scripts/check-ai-call-sites.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@google/genai": "latest",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "latest",
    "bullmq": "^6.1.1",
    "concurrently": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.12",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "latest",
    "qrcode": "latest",
    "ws": "^8.21.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@smithy/util-stream": "^4.8.2",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "latest",
    "@types/ws": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
